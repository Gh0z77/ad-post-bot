# Ixtiyoriy:
FOUNDER_USERNAME=dior_coder
ADMIN_IDS=123456789,987654321
# Postgres bo'lsa (Neon/Supabase/Render): sqlite o'rniga shundan foydalanadi
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Web panel manzili (Render Web Service URL): bot shu linkni userga beradi
# WEB_URL=https://sizning-saytingiz.onrender.com
# Web panel imzo kaliti (bo'sh bo'lsa BOT_TOKEN ishlatiladi, alohida sirli satr tavsiya qilinadi):
# WEB_SECRET=tasodifiy_uzun_sir_123
# Vercel cron himoyasi (/api/cron?secret=...): bo'sh bo'lsa himoya yo'q
# CRON_SECRET=tasodifiy_sir
# Web scheduler ni o'chirish uchun (agar 2+ replica ishlasa dublikat yubormaslik uchun):
# ENABLE_SCHEDULER=1
# Web panel porti (lokalda):
# PORT=5000
